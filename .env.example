# ---------------------------------------------------------------------------
# ShredNote environment configuration
# Copy to `.env.local` for development. Never commit real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string the application uses at runtime (any managed
# Postgres: Neon, Supabase, RDS...). Use the POOLED connection string if your
# provider offers one - serverless functions open many short-lived connections.
DATABASE_URL="postgresql://user:password@localhost:5432/shrednote?schema=public"

# Connection string used for MIGRATIONS only. Must be a DIRECT (unpooled)
# connection: a transaction-mode pooler cannot run DDL or hold the advisory
# lock Prisma uses to serialise migrations.
#   Neon     - the connection string without "-pooler" in the host
#   Supabase - port 5432 rather than the 6543 pooler
#   Plain Postgres with no pooler - the same value as DATABASE_URL
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/shrednote?schema=public"

# Canonical public origin. Used to build note links, canonical SEO URLs,
# sitemap entries and to scope security headers. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 32+ byte random secret used to HMAC client IP addresses before they are used
# as rate-limit keys, and to sign the admin session cookie.
# Generate with: openssl rand -base64 48
SERVER_SECRET=""

# Admin dashboard credentials.
# ADMIN_PASSWORD_HASH is a scrypt hash produced by: npm run admin:hash
# (see scripts/hash-admin-password.mjs). Never store a plaintext password.
# The hash contains no characters that need quoting or escaping.
ADMIN_PASSWORD_HASH=

# Shared secret for the scheduled cleanup endpoint (/api/cron/cleanup).
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=""
